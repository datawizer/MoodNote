{
  "expo": {
    "name": "MoodNote",
    "slug": "moodnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8f5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodnote.journal",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "MoodNote uses Face ID to protect your private journal entries.",
        "NSPhotoLibraryUsageDescription": "MoodNote needs photo library access to export your journal reports."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf8f5"
      },
      "package": "com.moodnote.journal",
      "versionCode": 1,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d97706",
          "sounds": ["./assets/chime.wav"]
        }
      ],
      [
        "react-native-purchases",
        {
          "apiKey": "appl_moodnote_revenuecat_key_placeholder"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier will only be used to deliver non-intrusive contextual ads."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "moodnote-expo-project-id"
      }
    }
  }
}
